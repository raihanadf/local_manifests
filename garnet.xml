<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- lineageos 23.2 (android 16) trees for xiaomi garnet, mirrors device/xiaomi/garnet lineage.dependencies -->
  <!-- own remote so paths don't depend on how crave mirrors the lineage manifest -->
  <remote name="garnet-gh" fetch="https://github.com" revision="refs/heads/lineage-23.2" />

  <!-- device -->
  <project path="device/xiaomi/garnet" name="LineageOS/android_device_xiaomi_garnet" remote="garnet-gh" />

  <!-- vendor blobs -->
  <project path="vendor/xiaomi/garnet" name="TheMuppets/proprietary_vendor_xiaomi_garnet" remote="garnet-gh" clone-depth="1" />

  <!-- kernel -->
  <project path="kernel/xiaomi/sm7435" name="LineageOS/android_kernel_xiaomi_sm7435" remote="garnet-gh" />
  <project path="kernel/xiaomi/sm7435-modules" name="LineageOS/android_kernel_xiaomi_sm7435-modules" remote="garnet-gh" />
  <project path="kernel/xiaomi/sm7435-devicetrees" name="LineageOS/android_kernel_xiaomi_sm7435-devicetrees" remote="garnet-gh" />

  <!-- hardware -->
  <project path="hardware/xiaomi" name="LineageOS/android_hardware_xiaomi" remote="garnet-gh" />
</manifest>
